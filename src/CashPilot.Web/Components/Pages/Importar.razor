@page "/importar"
@using System.Globalization
@using CashPilot.Domain.Transactions
@using CashPilot.Infrastructure.Importing
@inject CashPilotStore Store
@inject ToastService Toasts
@inject ImageTextReader ImageReader
@inject ClaudeBillReader Claude
@inject InboxService Inbox
@implements IDisposable

<PageTitle>Importar — CashPilot</PageTitle>

<h1>Importar</h1>

@if (Inbox.Enabled || _inbox.Count > 0)
{
    <section class="card-box wide">
        <h2>Faturas da pasta</h2>
        <p class="muted">
            @if (Inbox.Enabled)
            {
                <span>Pasta vigiada: <code>@Inbox.Folder</code>. Cada subpasta tem o nome de uma conta ou cartão; o que você joga nela é lido aqui e fica nesta fila até você conferir e importar.</span>
            }
            else
            {
                <span>A pasta vigiada não está configurada (<code>CashPilot:InboxFolder</code>); ficaram estes itens de antes.</span>
            }
        </p>
        @if (Inbox.Enabled)
        {
            <p>
                <button @onclick="ScanInbox" disabled="@_inboxBusy">@(_inboxBusy ? "Verificando…" : "Verificar agora")</button>
                <span class="muted"> @Inbox.LastMessage @(Inbox.LastScan is { } at ? $"(às {at:HH:mm})" : "")</span>
            </p>
        }
        @if (_inboxError is not null)
        {
            <p class="error">@_inboxError</p>
        }
        @if (_inbox.Count == 0)
        {
            <p class="muted">Nada esperando conferência.</p>
        }
        @foreach (var item in _inbox)
        {
            <div class="inbox-item">
                <h3>@item.Account <span class="muted">· @item.FileName · @item.CreatedAt</span></h3>
                @if (item.Note is not null)
                {
                    <p class="muted">@item.Note</p>
                }
                @if (item.Status == "pending")
                {
                    <textarea class="paste" rows="8" value="@InboxText(item)"
                              @oninput="e => _inboxEdits[item.Id] = e.Value?.ToString() ?? string.Empty"></textarea>
                    <p>
                        <button class="primary" @onclick="() => ImportInbox(item)">Importar para @item.Account (@item.Entries lançamentos)</button>
                        <button @onclick="() => DismissInbox(item)">Descartar</button>
                    </p>
                }
                else
                {
                    <p><button @onclick="() => DismissInbox(item)">Descartar</button></p>
                }
            </div>
        }
    </section>
}

<section class="card-box wide">
    <h2>Enviar arquivo</h2>
    <p class="muted">
        CSV, TXT, PDF (com texto) ou imagem (PNG, JPG; leitura de texto no seu computador, sem enviar nada para fora). O tipo é reconhecido sozinho: extrato do Bradesco (CSV ou PDF), extrato do Itaú (PDF)
        ou a planilha de gastos. Os extratos mostram uma prévia antes de gravar; o que já foi importado, ou que parece
        repetir um lançamento que você já tem, não entra de novo.
    </p>
    <InputFile OnChange="LoadFile" accept=".csv,.ofx,.qfx,.txt,.pdf,.png,.jpg,.jpeg,.bmp,.tif,.tiff,text/csv,text/plain,application/pdf,image/*" />
    @if (_fileMessage is not null)
    {
        <p class="muted">@_fileMessage</p>
    }

    @if (_statement is not null)
    {
        <h3>@_fileName: extrato @_statement.Format, @_statement.Entries.Count lançamentos (@StatementPeriod)</h3>
        <div class="filters">
            <label>Conta do extrato
                <input list="dl-sources" @bind="_bankAccount" placeholder="ex.: Banco Bradesco PF" />
            </label>
            <button @onclick="BuildPreview">Ver prévia</button>
        </div>
        @foreach (var warning in _statement.Warnings)
        {
            <p class="error">@warning</p>
        }
        <Rejected Items="_statement.Rejected" />

        @if (_preview is not null)
        {
            <ul class="result">
                <li><strong>@_preview.Count(CandidateStatus.New)</strong> novos</li>
                <li><strong>@_preview.Count(CandidateStatus.Duplicate)</strong> já importados</li>
                <li><strong>@_preview.Count(CandidateStatus.Similar)</strong> parecem lançamentos que você já tem (vêm desmarcados; marque os que forem diferentes)</li>
            </ul>
            <div class="scroll">
                <table class="grid">
                    <thead>
                        <tr><th></th><th>Data</th><th>Descrição</th><th class="num">Valor</th><th>Classificação</th><th>Situação</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _preview.Candidates)
                        {
                            <tr class="@(c.Status == CandidateStatus.New ? "" : "dim")">
                                <td><input type="checkbox" checked="@_included.Contains(c.Index)"
                                           disabled="@(c.Status == CandidateStatus.Duplicate)"
                                           @onchange="e => Toggle(c.Index, e.Value is true)" /></td>
                                <td>@c.Entry.Date.ToString("dd/MM/yyyy")</td>
                                <td>@c.Transaction.RawDescription</td>
                                <td class="num @(c.Entry.Amount < 0 ? "neg" : "")">@c.Entry.Amount.ToString("N2", Br)</td>
                                <td>@Describe(c.Transaction)</td>
                                <td>@StatusText(c)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p><button class="primary" @onclick="ConfirmImport">Importar @_included.Count lançamentos para @_preview.Account</button></p>
        }
    }

    @if (_bankResult is not null)
    {
        <ul class="result">
            <li><strong>@_bankResult.Inserted</strong> lançamentos importados, <strong>@_bankResult.Skipped</strong> deixados de fora</li>
            @if (_bankResult.TransferPairs > 0)
            {
                <li><strong>@_bankResult.TransferPairs</strong> transferências entre suas contas reconhecidas (não contam como gasto)</li>
            }
            <li>o que não foi classificado está em <a href="pendentes">Pendentes</a>: lá você cadastra o gasto ou marca "Entre minhas contas"</li>
        </ul>
    }
</section>

<section class="card-box">
    <h2>Planilha de gastos (CSV)</h2>
    <p class="muted">
        Exporte a aba "Gastos" como CSV (colunas: Dia, Categoria, Ítem, Conta, Valor, Obs).
        Pode enviar o mesmo arquivo de novo: lançamentos já importados não duplicam.
    </p>
    <InputFile OnChange="ImportGastos" accept=".csv,text/csv" />

    @if (_gastos is not null)
    {
        <ul class="result">
            <li><strong>@_gastos.RowsRead</strong> linhas lidas</li>
            <li><strong>@_gastos.Inserted</strong> novas, <strong>@_gastos.Duplicates</strong> já existiam</li>
            <li><strong>@_gastos.TaughtFromSheet</strong> ensinaram o classificador, <strong>@_gastos.ClassifiedByRules</strong> classificadas por regras</li>
            <li><strong>@_gastos.CardCashOut</strong> saques na maquininha</li>
            <li><strong>@_gastos.Pending</strong> pendentes (<a href="pendentes">classificar</a>)</li>
        </ul>
        <Rejected Items="_gastos.Rejected" />
    }
</section>

<section class="card-box">
    <h2>Regras (CSV)</h2>
    <p class="muted">Colunas: pattern, category, item. Cada linha vira uma regra "contém" e reaplica nos pendentes.</p>
    <InputFile OnChange="ImportRules" accept=".csv,text/csv" />

    @if (_rules is not null)
    {
        <ul class="result">
            <li><strong>@_rules.RulesSaved</strong> regras salvas</li>
            <li><strong>@_rules.Reclassified</strong> lançamentos classificados, <strong>@_rules.StillPending</strong> ainda pendentes</li>
        </ul>
        <Rejected Items="_rules.Rejected" />
    }
</section>

<section class="card-box wide">
    <h2>Fatura de cartão ou extrato (texto)</h2>
    <p class="muted">
        Escolha de qual conta ou cartão são os lançamentos e cole as linhas copiadas do app, ou envie a fatura em PDF (com texto), um print dela ou um .txt.
        Aceita "05 Out" ou "05/10" sozinhos numa linha, valendo para as linhas de baixo; "Parcela 1 de 3" numa linha vira
        a parcela do lançamento acima; linhas com # no começo são ignoradas.
        Pode colar de novo o mesmo trecho: o que já existe não duplica.
    </p>
    <div class="filters">
        <label>Conta ou cartão
            <input list="dl-sources" @bind="_source" placeholder="ex.: Cartão Bradesco PF" />
            <datalist id="dl-sources">
                @foreach (var name in _sources)
                {
                    <option value="@name"></option>
                }
            </datalist>
        </label>
        <label class="check"><input type="checkbox" @bind="_positiveAreExpenses" /> valores positivos são gastos (fatura de cartão)</label>
    </div>
    <InputFile OnChange="LoadText" accept=".txt,.csv,.pdf,.png,.jpg,.jpeg,text/plain,application/pdf,image/*" />
    @if (_textMessage is not null)
    {
        <p class="muted">@_textMessage</p>
    }
    @if (_textError is not null)
    {
        <p class="error">@_textError</p>
    }
    @if (_billImages.Count > 0)
    {
        @if (Claude.IsConfigured)
        {
            <p>
                <button @onclick="ReadWithAi" disabled="@_aiBusy">@(_aiBusy ? "Lendo com IA…" : "Ler com IA")</button>
                <span class="muted"> Envia a imagem à API da Anthropic (sai do seu computador, uso cobrado na sua chave) e troca o texto abaixo.</span>
            </p>
        }
        else
        {
            <p class="muted">
                Quer uma leitura mais precisa? Configure uma chave da API da Anthropic
                (<code>dotnet user-secrets set "CashPilot:AnthropicApiKey" "sua-chave"</code> em src/CashPilot.Web) e reinicie: aparece o botão "Ler com IA".
            </p>
        }
    }
    <textarea class="paste" rows="10" @bind="_pasted" @bind:event="oninput" placeholder="@ExamplePlaceholder"></textarea>
    <p><button class="primary" @onclick="ImportText">Importar para @(string.IsNullOrWhiteSpace(_source) ? "…" : _source)</button></p>

    @if (_text is not null)
    {
        <ul class="result">
            <li><strong>@_textEntries</strong> lançamentos lidos</li>
            <li><strong>@_text.Inserted</strong> novos, <strong>@_text.Duplicates</strong> já existiam</li>
            <li><strong>@_text.ClassifiedByRules</strong> classificados por regras, <strong>@_text.CardCashOut</strong> saques na maquininha</li>
            <li><strong>@_text.Pending</strong> pendentes (<a href="pendentes">classificar</a>)</li>
        </ul>
    }
    <Rejected Items="_textRejected" />
</section>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

@code {
    private const long MaxFileBytes = 10 * 1024 * 1024;
    // A bill exported by a bank app as "a picture of the screen" can be huge (the real one is 80 MB); the app runs on this PC only.
    private const long MaxBillBytes = 150L * 1024 * 1024;
    private static readonly CultureInfo Br = new("pt-BR");

    private BankStatement? _statement;
    private BankPreview? _preview;
    private BankImportResult? _bankResult;
    private readonly HashSet<int> _included = new();
    private string _bankAccount = "";
    private string _fileName = "";
    private string? _fileMessage;
    private string? _textMessage;
    private string? _textError;

    private string StatementPeriod => _statement is { Entries.Count: > 0 }
        ? $"{_statement.Entries.Min(e => e.Date):dd/MM/yyyy} a {_statement.Entries.Max(e => e.Date):dd/MM/yyyy}"
        : "sem lançamentos";

    // In a C# string the line breaks are real; as "&#10;" in the attribute Blazor showed them as text.
    private const string ExamplePlaceholder = "05 Out\nANTHROPIC* CLAUDE SUB   R$ 110,00\nCIZI MERCADO EXPRESS   R$ 19,56";

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        _error = null;
        _fileMessage = null;
        _statement = null;
        _preview = null;
        _bankResult = null;
        _included.Clear();

        byte[] bytes;
        try
        {
            using var stream = e.File.OpenReadStream(MaxFileBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            bytes = memory.ToArray();
        }
        catch (IOException ex)
        {
            _error = "Não foi possível ler o arquivo (limite 10 MB): " + ex.Message;
            return;
        }

        _fileName = e.File.Name;
        if (ImageTextReader.IsImage(_fileName))
        {
            try
            {
                _billImages = new() { bytes };
                _pasted = (await Task.Run(() => ReadBillImage(bytes))).Text;
                _fileMessage = "Texto lido da imagem. O reconhecimento pode errar números e letras: confira a caixa "
                               + "\"Fatura de cartão ou extrato (texto)\", mais abaixo, corrija o que precisar, escolha a conta ou o cartão e importe.";
            }
            catch (InvalidOperationException ex)
            {
                _error = ex.Message;
            }
            return;
        }

        var loaded = ImportFileLoader.Load(_fileName, bytes);
        switch (loaded.Kind)
        {
            case ImportKind.BankStatement:
                _statement = loaded.Statement;
                var suggested = new BankStatementImporter(Store).SuggestAccounts(_statement!);
                _bankAccount = suggested.Count == 1 ? suggested[0] : "";
                if (_bankAccount.Length > 0) BuildPreview();
                else _fileMessage = "Extrato reconhecido. Escolha a conta e clique em Ver prévia.";
                break;

            case ImportKind.GastosSheet:
                try
                {
                    _gastos = new GastosImporter(Store).Import(new StringReader(loaded.Text!), _fileName);
                    _fileMessage = "Planilha de gastos reconhecida e importada (resultado na seção da planilha, abaixo).";
                    Toasts.Success($"Planilha importada: {_gastos.Inserted} novas, {_gastos.Duplicates} já existiam.");
                }
                catch (Exception ex) when (ex is InvalidDataException or FormatException)
                {
                    _error = ex.Message;
                }
                break;

            case ImportKind.PlainText:
                _pasted = loaded.Text!;
                _fileMessage = loaded.Note
                               ?? "Texto reconhecido, mas sem formato de extrato conhecido. Ele foi para a caixa "
                                  + "\"Fatura de cartão ou extrato (texto)\", mais abaixo: escolha a conta ou o cartão e importe lá.";
                break;

            default:
                _error = loaded.Error ?? "Arquivo não reconhecido.";
                break;
        }
    }

    private void BuildPreview()
    {
        _error = null;
        _preview = null;
        _bankResult = null;
        if (_statement is null) return;
        if (string.IsNullOrWhiteSpace(_bankAccount)) { _error = "Escolha a conta do extrato."; return; }

        var importer = new BankStatementImporter(Store);
        _preview = importer.Preview(_statement, _bankAccount);
        _included.Clear();
        foreach (var candidate in _preview.Candidates.Where(c => c.Status == CandidateStatus.New))
            _included.Add(candidate.Index);
    }

    private void Toggle(int index, bool on)
    {
        if (on) _included.Add(index);
        else _included.Remove(index);
    }

    private void ConfirmImport()
    {
        if (_preview is null) return;
        _bankResult = new BankStatementImporter(Store).Import(
            _preview, _included, "extrato:" + _fileName);
        Toasts.Success($"{_bankResult.Inserted} lançamentos importados em {_preview.Account}.");
        _sources = Store.GetAccounts().Select(a => a.Name)
            .Concat(Store.GetAccountNamesInUse())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        _preview = null;
        _statement = null;
        _included.Clear();
    }

    private static string Describe(Transaction transaction) => transaction.Type switch
    {
        TransactionType.CardBillPayment => "Pagamento de fatura (não é gasto)",
        TransactionType.InternalTransfer => "Entre minhas contas",
        _ when transaction.Category is not null =>
            string.IsNullOrEmpty(transaction.Item) ? transaction.Category : $"{transaction.Category} › {transaction.Item}",
        TransactionType.Deposit => "A classificar (entrada)",
        _ => "A classificar",
    };

    private static string StatusText(BankCandidate candidate) => candidate.Status switch
    {
        CandidateStatus.New => "novo",
        CandidateStatus.Duplicate => "já importado",
        _ => candidate.Note ?? "parece repetido",
    };

    private const long MaxBytes = 5 * 1024 * 1024;

    private ImportResult? _gastos;
    private ImportResult? _text;
    private int _textEntries;
    private IReadOnlyList<RejectedRow> _textRejected = Array.Empty<RejectedRow>();
    private List<string> _sources = new();
    private string _source = "";
    private string _pasted = "";
    private List<byte[]> _billImages = new();
    private bool _aiBusy;
    private bool _positiveAreExpenses = true;
    private RulesImportResult? _rules;
    private string? _error;

    private IReadOnlyList<InboxItem> _inbox = Array.Empty<InboxItem>();
    private readonly Dictionary<long, string> _inboxEdits = new();
    private bool _inboxBusy;
    private string? _inboxError;

    private string InboxText(InboxItem item) => _inboxEdits.TryGetValue(item.Id, out var edited) ? edited : item.Text;

    private async Task ScanInbox()
    {
        _inboxBusy = true;
        StateHasChanged();
        await Inbox.ScanNowAsync();
        _inboxBusy = false;
        _inbox = Store.GetOpenInboxItems();
    }

    private void ImportInbox(InboxItem item)
    {
        _inboxError = null;
        var account = Store.GetAccounts().FirstOrDefault(a => string.Equals(a.Name, item.Account, StringComparison.OrdinalIgnoreCase));
        var (result, error) = InboxImport.Import(Store, item, InboxText(item), account?.Kind != CashPilot.Domain.Accounts.AccountKind.BankAccount,
            DateOnly.FromDateTime(DateTime.Today));
        if (result is null) { _inboxError = error; return; }

        _inboxEdits.Remove(item.Id);
        _inbox = Store.GetOpenInboxItems();
        Toasts.Success($"Importado em {item.Account}: {result.Inserted} novos, {result.Duplicates} já existiam.");
    }

    private void DismissInbox(InboxItem item)
    {
        Store.DeleteInboxItem(item.Id);
        _inboxEdits.Remove(item.Id);
        _inbox = Store.GetOpenInboxItems();
    }

    // The folder worker runs on its own thread: when it queues something, this page refreshes its list.
    private void OnInboxChanged() => _ = InvokeAsync(() =>
    {
        _inbox = Store.GetOpenInboxItems();
        StateHasChanged();
    });

    public void Dispose() => Inbox.Changed -= OnInboxChanged;

    protected override void OnInitialized()
    {
        _inbox = Store.GetOpenInboxItems();
        Inbox.Changed += OnInboxChanged;
        _sources = Store.GetAccounts().Select(a => a.Name)
            .Concat(Store.GetAccountNamesInUse())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }

    /// <summary>OCR of a screenshot; when it looks like a card bill the text is already in "dd/MM DESC R$ amount" lines.</summary>
    private (string Text, string Message) ReadBillImage(byte[] bytes)
    {
        var raw = ImageReader.Read(bytes);
        var bill = CardBillPdf.FromOcrText(raw);
        if (bill is { Entries: > 0 })
            return (bill.Text, $"Fatura lida da imagem: {bill.Entries} lançamentos"
                         + (bill.Repaired > 0 ? $" ({bill.Repaired} data(s) com o mês refeito pelas linhas vizinhas)" : "")
                         + ". A leitura óptica pode errar números e letras: confira cada linha, escolha o cartão e importe. Linhas com ?? na data precisam de acerto.");
        return (raw, "Texto lido da imagem. O reconhecimento pode errar números e letras: confira e corrija antes de importar.");
    }

    private async Task ReadWithAi()
    {
        _aiBusy = true;
        _textError = null;
        _textMessage = "Enviando a imagem para a IA…";
        StateHasChanged();
        try
        {
            var result = await Claude.ReadAsync(_billImages);
            _pasted = result.Text;
            _textMessage = $"A IA leu {result.Entries} lançamentos. Confira as linhas, escolha o cartão e importe.";
        }
        catch (InvalidOperationException ex)
        {
            _textMessage = null;
            _textError = ex.Message;
        }
        finally
        {
            _aiBusy = false;
        }
    }

    private async Task LoadText(InputFileChangeEventArgs e)
    {
        // A card bill PDF (or a screenshot of one) is read here too, so it does not have to be copied by hand.
        // Messages from this field stay inside its own card: the page-level error is far below and easy to miss.
        _textMessage = null;
        _textError = null;
        _billImages = new();
        if (e.File.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) || ImageTextReader.IsImage(e.File.Name))
        {
            byte[] bytes;
            try
            {
                using var stream = e.File.OpenReadStream(MaxBillBytes);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                bytes = memory.ToArray();
            }
            catch (IOException ex)
            {
                _textError = "Não foi possível ler o arquivo (limite 150 MB): " + ex.Message;
                return;
            }

            _textMessage = "Lendo o arquivo…";
            StateHasChanged();
            try
            {
                if (ImageTextReader.IsImage(e.File.Name))
                {
                    _billImages = new() { bytes };
                    var (imageText, imageMessage) = await Task.Run(() => ReadBillImage(bytes));
                    _pasted = imageText;
                    _textMessage = imageMessage;
                    return;
                }

                // An account statement PDF is not a card bill: say so instead of importing it into a card.
                var loaded = await Task.Run(() => ImportFileLoader.Load(e.File.Name, bytes));
                if (loaded.Kind == ImportKind.BankStatement)
                {
                    _textMessage = null;
                    _textError = "Este PDF é um extrato de conta, não uma fatura de cartão. Envie-o em \"Enviar arquivo\", no alto da página.";
                    return;
                }
                if (loaded.Kind == ImportKind.PlainText)
                {
                    _pasted = loaded.Text!;
                    _textMessage = loaded.Note ?? "Texto lido do PDF. Confira as linhas e importe.";
                    return;
                }

                // No text in the PDF (a picture of the app screen, which cannot be copied): read it with OCR.
                var (result, error) = await Task.Run(() => CardBillPdf.FromPdf(bytes, image => ImageReader.Read(image)));
                if (result is null)
                {
                    _textMessage = null;
                    _textError = error ?? loaded.Error ?? "Arquivo não reconhecido.";
                    return;
                }
                _pasted = result.Text;
                _billImages = await Task.Run(() => CardBillPdf.ReadPictures(bytes));
                _textMessage = $"Fatura lida: {result.Entries} lançamentos"
                               + (result.Skipped > 0 ? $" ({result.Skipped} linha(s) de pagamento ou saldo anterior ficaram de fora)" : "")
                               + ". Como o PDF é uma imagem, o texto vem de leitura óptica: confira valores e descrições, escolha o cartão e importe.";
            }
            catch (InvalidOperationException ex)
            {
                _textMessage = null;
                _textError = ex.Message;
            }
            return;
        }

        _error = null;
        var text = await ReadAsync(e);
        if (text is not null) _pasted = text;
    }

    private void ImportText()
    {
        _error = null;
        _text = null;
        _textRejected = Array.Empty<RejectedRow>();
        if (string.IsNullOrWhiteSpace(_source)) { _error = "Escolha a conta ou o cartão."; return; }
        if (string.IsNullOrWhiteSpace(_pasted)) { _error = "Cole as linhas do extrato ou da fatura."; return; }

        var today = DateOnly.FromDateTime(DateTime.Today);
        var converted = StatementText.ToGastosCsv(_pasted, _source, today, _positiveAreExpenses);
        _textEntries = converted.Entries;
        _textRejected = converted.Rejected;
        if (converted.Entries == 0) { _error = "Nenhum lançamento reconhecido."; return; }

        _text = new GastosImporter(Store).Import(new StringReader(converted.Csv), "texto:" + _source.Trim());
        Toasts.Success($"Importado em {_source.Trim()}: {_text.Inserted} novos, {_text.Duplicates} já existiam.");
    }

    private async Task<string?> ReadAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        try
        {
            using var stream = e.File.OpenReadStream(MaxBytes);
            using var reader = new StreamReader(stream);
            return await reader.ReadToEndAsync();
        }
        catch (IOException ex)
        {
            _error = "Não foi possível ler o arquivo (limite 5 MB): " + ex.Message;
            return null;
        }
    }

    private async Task ImportGastos(InputFileChangeEventArgs e)
    {
        var text = await ReadAsync(e);
        if (text is null) return;
        try
        {
            _gastos = new GastosImporter(Store).Import(new StringReader(text), e.File.Name);
            Toasts.Success($"Planilha importada: {_gastos.Inserted} novas, {_gastos.Duplicates} já existiam.");
        }
        catch (Exception ex) when (ex is InvalidDataException or FormatException)
        {
            _gastos = null;
            _error = ex.Message;
        }
    }

    private async Task ImportRules(InputFileChangeEventArgs e)
    {
        var text = await ReadAsync(e);
        if (text is null) return;
        try
        {
            _rules = new RulesImporter(Store).Import(new StringReader(text));
            Toasts.Success($"Regras importadas: {_rules.RulesSaved} salvas, {_rules.Reclassified} lançamentos classificados.");
        }
        catch (Exception ex) when (ex is InvalidDataException or FormatException)
        {
            _rules = null;
            _error = ex.Message;
        }
    }
}
