@* A headline number with an icon and, optionally, a change against the previous period. *@
<div class="kpi">
    <div class="kpi-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="@IconPath(Icon)" />
        </svg>
    </div>
    <div class="kpi-body">
        <span class="kpi-label">@Label</span>
        <strong class="kpi-value">@Value</strong>
        @if (!string.IsNullOrEmpty(Note))
        {
            <span class="kpi-note @NoteClass">@Note</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Note { get; set; }
    /// <summary>"good", "bad" or empty (neutral): decides the color of the note.</summary>
    [Parameter] public string NoteClass { get; set; } = "";
    /// <summary>wallet, list, alert or trend.</summary>
    [Parameter] public string Icon { get; set; } = "wallet";

    private static string IconPath(string icon) => icon switch
    {
        "list" => "M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01",
        "alert" => "M12 3 2 20h20L12 3ZM12 10v5M12 18h.01",
        "trend" => "M3 17l6-6 4 4 7-8M15 7h5v5",
        _ => "M3 7h15a3 3 0 0 1 3 3v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7ZM3 7l3-3h11M16 14h2",
    };
}
