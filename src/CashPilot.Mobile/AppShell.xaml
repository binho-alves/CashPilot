<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:CashPilot.Mobile.Pages"
       x:Class="CashPilot.Mobile.AppShell"
       Shell.TabBarBackgroundColor="#0F766E"
       Shell.TabBarTitleColor="White"
       Shell.TabBarUnselectedColor="#B2DFDB"
       Shell.NavBarIsVisible="False">
    <TabBar>
        <ShellContent Title="Novo" Route="novo" ContentTemplate="{DataTemplate pages:NewEntryPage}" />
        <ShellContent Title="Últimos" Route="ultimos" ContentTemplate="{DataTemplate pages:RecentPage}" />
        <ShellContent Title="Config." Route="config" ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </TabBar>
</Shell>
